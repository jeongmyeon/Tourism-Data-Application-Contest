package com.trip.travel.controller;

import com.trip.travel.dto.WeatherDto;
import com.trip.travel.service.ParkingService;
import com.trip.travel.service.TourApiService;
import com.trip.travel.service.WeatherService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;

@Slf4j
@RestController
@RequestMapping("/api")
@RequiredArgsConstructor
public class TravelController {

    private final TourApiService tourApiService;
    private final WeatherService weatherService;
    private final ParkingService parkingService;

    // 관광지 목록
    @GetMapping("/tour/spots")
    public ResponseEntity<List<Map<String, Object>>> getTourSpots(
            @RequestParam(defaultValue = "12") String contentTypeId,
            @RequestParam(defaultValue = "1") int pageNo) {
        return ResponseEntity.ok(tourApiService.getGangwonTourSpots(contentTypeId, pageNo));
    }

    // 축제 목록
    @GetMapping("/tour/festivals")
    public ResponseEntity<List<Map<String, Object>>> getFestivals() {
        return ResponseEntity.ok(tourApiService.getGangwonFestivals());
    }

    // 관광지 검색
    @GetMapping("/tour/search")
    public ResponseEntity<List<Map<String, Object>>> searchSpots(
            @RequestParam("ketword") String keyword) {
        return ResponseEntity.ok(tourApiService.searchTourSpots(keyword));
    }

    // 강원도 전체 날씨
    @GetMapping("/weather/gangwon")
    public ResponseEntity<List<WeatherDto>> getGangwonWeather() {
        return ResponseEntity.ok(weatherService.getAllGangwonWeather());
    }

    // 특정 지역 날씨
    @GetMapping("/weather")
    public ResponseEntity<WeatherDto> getWeather(
            @RequestParam("location") String location,
            @RequestParam("nx") int nx,
            @RequestParam("ny") int ny) {
        return ResponseEntity.ok(weatherService.getWeatherByGrid(location, nx, ny));
    }
    
    // 3일치 날씨 조회
    @GetMapping("/weather/forecast")
    public ResponseEntity<List<Map<String, String>>> get3DayForecast(
    		@RequestParam("location") String location,
    		@RequestParam("nx") int nx,
    		@RequestParam("ny") int ny){
    	return ResponseEntity.ok(weatherService.get3DayForecast(location, nx, ny));
    }

    // 강원도 전체 주차
    @GetMapping("/parking/gangwon")
    public ResponseEntity<Map<String, List<Map<String, Object>>>> getGangwonParking() {
        return ResponseEntity.ok(parkingService.getAllGangwonParking());
    }

    // 도시별 주차
    @GetMapping("/parking")
    public ResponseEntity<List<Map<String, Object>>> getParkingByCity(
            @RequestParam String cityCode) {
        return ResponseEntity.ok(parkingService.getParkingByCity(cityCode));
    }

    // 메인 대시보드 통합
    @GetMapping("/dashboard")
    public ResponseEntity<Map<String, Object>> getDashboard() {
        Map<String, Object> dashboard = Map.of(
            "weather", weatherService.getAllGangwonWeather(),
            "festivals", tourApiService.getGangwonFestivals(),
            "parking", parkingService.getAllGangwonParking()
        );
        return ResponseEntity.ok(dashboard);
    }
}