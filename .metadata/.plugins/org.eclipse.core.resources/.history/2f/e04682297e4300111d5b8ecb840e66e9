            129.3456,
            "삼척",
            "동해",
            15,
            Arrays.asList("화장실", "편의점", "주유소", "주차장"),
            "033-575-1234",
            "06:00 - 22:00"
        ));

        restAreas.add(createRestArea(
            "현북휴게소",
            "상행",
            37.4789,
            129.1234,
            "동해",
            "양양",
            25,
            Arrays.asList("화장실", "편의점", "식당", "주차장", "전기차충전소"),
            "033-534-5678",
            "24시간"
        ));

        restAreas.add(createRestArea(
            "양양휴게소",
            "상행",
            38.0123,
            128.6789,
            "양양",
            "속초",
            20,
            Arrays.asList("화장실", "편의점", "주유소", "식당", "주차장"),
            "033-672-9012",
            "06:00 - 23:00"
        ));

        // 하행 (속초 → 삼척)
        restAreas.add(createRestArea(
            "양양휴게소",
            "하행",
            38.0123,
            128.6789,
            "속초",
            "양양",
            20,
            Arrays.asList("화장실", "편의점", "주유소", "주차장"),
            "033-672-9013",
            "06:00 - 23:00"
        ));

        restAreas.add(createRestArea(
            "현북휴게소",
            "하행",
            37.4789,
            129.1234,
            "양양",
            "동해",
            25,
            Arrays.asList("화장실", "편의점", "식당", "주차장"),
            "033-534-5679",
            "24시간"
        ));

        restAreas.add(createRestArea(
            "임원휴게소",
            "하행",
