package com.trip.travel.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.UriComponentsBuilder;

import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class RestAreaService {

    private final WebClient.Builder webClientBuilder;

    @Value("${api.restarea.key:}")
    private String restAreaApiKey;

    // 동해고속도로 노선 코드 (API에 따라 다를 수 있음)
    private static final String DONGHAE_ROUTE_CODE = "0650"; // 동해고속도로

    /**
     * 동해고속도로 휴게소 목록 조회
     */
    @Cacheable(value = "restAreas", key = "'donghae'")
    public List<Map<String, Object>> getDonghaeRestAreas() {
        // 실제 API가 없을 경우 Mock 데이터 사용
        if (restAreaApiKey == null || restAreaApiKey.isEmpty()) {
            log.info("휴게소 API 키 없음 - Mock 데이터 반환");
            return getMockRestAreas();
        }

        // 실제 API 호출 (한국도로공사 API 예시)
        String url = UriComponentsBuilder
                .fromUriString("https://data.ex.co.kr/openapi/restinfo/restBisic")
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("routeCode", DONGHAE_ROUTE_CODE)
                .build(false)
                .toUriString();

        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            List<Map<String, Object>> items = extractRestAreas(response);
            log.info("동해고속도로 휴게소 조회: {}건", items.size());
            return items;

        } catch (Exception e) {
            log.error("휴게소 API 조회 실패: {}", e.getMessage());
            return getMockRestAreas();
        }
    }

    /**
     * Mock 데이터 (API 없을 때 사용)
     */
    private List<Map<String, Object>> getMockRestAreas() {
        List<Map<String, Object>> restAreas = new ArrayList<>();

        // 상행 (삼척 → 속초)
        restAreas.add(createRestArea(
