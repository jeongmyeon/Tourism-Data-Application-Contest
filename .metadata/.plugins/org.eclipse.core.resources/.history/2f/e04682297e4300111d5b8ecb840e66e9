            129.3456,
            "동해",
            "삼척",
            15,
            Arrays.asList("화장실", "편의점", "주차장"),
            "033-575-1235",
            "06:00 - 22:00"
        ));

        return restAreas;
    }

    private Map<String, Object> createRestArea(
            String name,
            String direction,
            double latitude,
            double longitude,
            String fromCity,
            String toCity,
            int timeMinutes,
            List<String> facilities,
            String tel,
            String operatingHours
    ) {
        Map<String, Object> restArea = new LinkedHashMap<>();
        restArea.put("name", name);
        restArea.put("direction", direction);
        restArea.put("latitude", latitude);
        restArea.put("longitude", longitude);
        restArea.put("fromCity", fromCity);
        restArea.put("toCity", toCity);
        restArea.put("timeMinutes", timeMinutes);
        restArea.put("facilities", facilities);
        restArea.put("tel", tel);
        restArea.put("operatingHours", operatingHours);
        return restArea;
    }

    /**
     * 구간별 휴게소 조회
     */
    public List<Map<String, Object>> getRestAreasByRoute(String fromCity, String toCity, String direction) {
        List<Map<String, Object>> allRestAreas = getDonghaeRestAreas();

        return allRestAreas.stream()
                .filter(area -> 
                    area.get("fromCity").equals(fromCity) &&
                    area.get("toCity").equals(toCity) &&
                    area.get("direction").equals(direction)
                )
                .collect(Collectors.toList());
    }

    @SuppressWarnings("unchecked")
    private List<Map<String, Object>> extractRestAreas(Map response) {
        try {
            // API 응답 구조에 맞게 수정 필요
            Map body = (Map) response.get("body");
            List<Map<String, Object>> items = (List<Map<String, Object>>) body.get("items");
            return items != null ? items : Collections.emptyList();
        } catch (Exception e) {
            log.warn("휴게소 응답 파싱 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }
}