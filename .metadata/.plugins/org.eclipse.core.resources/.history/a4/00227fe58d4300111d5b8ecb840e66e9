package com.trip.travel.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.UriComponentsBuilder;

import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class RestAreaService {

    private final WebClient.Builder webClientBuilder;

    @Value("${api.restarea.key}")
    private String restAreaApiKey;
    
    @Value("${api.restarea.base-url}")
    private String baseUrl;


    /* 동해고속도로 휴게소 전체 정보 조회 */
    @Cacheable(value = "restAreas", key = "'donghae'")
    public List<Map<String, Object>> getDonghaeRestAreas() {
        // 1. 기본정보 조회
        List<Map<String, Object>> basicInfo = getBasicRestAreaInfo();
        
        // 2. 좌표
        List<Map<String, Object>> coordinates = getRestAreaCoordinates();
        
        // 4. 편의시설 조회
        List<Map<String, Object>> facilities = getFacilitiesForRestAreaFacilities(basicInfo);
        
        // 4. 두 데이터 병합
        List<Map<String,Object>> merged = mergeRestAreaData(basicInfo, facilities);
        return classifyByLocation(merged);
    }

    /* 기본정보 API 호출 */
    private List<Map<String, Object>> getBasicRestAreaInfo() {
        String url = UriComponentsBuilder
                .fromUriString(baseUrl+"/openApiInfoM")
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("routeCd", "0650")
                .queryParam("numOfRows", 50)
                .queryParam("pageNo", 1)
                .build(false)
                .toUriString();

        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            List<Map<String, Object>> areas = extractList(response);
            log.info("동해고속도로 휴게소 조회 - 전체: {}건", areas.size());

            // 상세 로그
            areas.forEach(area -> {
                log.info("휴게소: {} ({}), 노선: {}, 방향: {}", 
                    area.get("unitNm"),
                    area.get("unitCd"),
                    area.get("routeNm"),
                    area.get("svarAddr"));
            });
            
            return areas;

        } catch (Exception e) {
            log.error("기본정보 API 조회 실패: {}", e.getMessage());
            e.printStackTrace();
            return Collections.emptyList();
        }
    }

    /* 편의시설 API 호출 */
    private List<Map<String, Object>> getFacilitiesForRestAreaFacilities(List<Map<String,Object>> restAreas) {
        Set<String> unitCodes = restAreas.stream()
        		.map(area -> String.valueOf(area.get("unitCd")))
        		.collect(Collectors.toSet());
        
        String url = UriComponentsBuilder
        		.fromUriString(baseUrl + "/curArcdentsStatus")
        		.queryParam("key",restAreaApiKey)
        		.queryParam("type","json")
        		.queryParam("numOfRows",100)
        		.queryParam("pageNo",1)
        		.build(false)
        		.toUriString();

        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            List<Map<String, Object>> allFacilities = extractList(response);
            
            List<Map<String, Object>> filtered = allFacilities.stream()
            		.filter(f -> unitCodes.contains(String.valueOf(f.get("unitCd"))))
            		.collect(Collectors.toList());
            log.info("편의시설 API - 전체: {}건", allFacilities.size());
            return allFacilities;

        } catch (Exception e) {
            log.error("편의시설 API 조회 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }

    /* 두 API 데이터 병합 */
    private List<Map<String, Object>> mergeRestAreaData(
            List<Map<String, Object>> basicInfo,
            List<Map<String, Object>> facilities) {
        
        return basicInfo.stream().map(basic -> {
            Map<String, Object> merged = new LinkedHashMap<>(basic);

            String unitCode = String.valueOf(basic.get("unitCd"));
            String unitName = String.valueOf(basic.get("unitNm"));
            String svarAddr = String.valueOf(basic.get("svarAddr"));

            // 편의시설 정보 매칭 (unitCd로)
            facilities.stream()
                    .filter(f -> unitCode.equals(String.valueOf(f.get("unitCd"))))
                    .findFirst()
                    .ifPresent(facility -> {
                        List<String> facilityList = new ArrayList<>();
                        if ("Y".equals(String.valueOf(facility.get("cvsstorYn")))) facilityList.add("편의점");
                        if ("Y".equals(String.valueOf(facility.get("restrmYn")))) facilityList.add("화장실");
                        if ("Y".equals(String.valueOf(facility.get("fuelYn")))) facilityList.add("주유소");
                        if ("Y".equals(String.valueOf(facility.get("lpgYn")))) facilityList.add("LPG충전소");
                        if ("Y".equals(String.valueOf(facility.get("chrstnYn")))) facilityList.add("전기차충전소");

                        merged.put("facilities", facilityList);
                        merged.put("tel", facility.get("phoneNumber"));
                    });

            // 기본 시설 설정
            if (!merged.containsKey("facilities")) {
                merged.put("facilities", Arrays.asList("화장실", "주차장"));
            }

            // 방향 
            String direction = parseDirection(svarAddr);
            merged.put("direction", direction);
            merged.put("name", unitName);

            return merged;
        }).collect(Collectors.toList());
    }

    /* 휴게소 이름과 방향으로 구간 정보 추정 */
    private List<Map<String, Object>> classifyByLocation(List<Map<String, Object>> restAreas) {
        // 도시 좌표 (대략적인 위도 기준)
        double SAMCHEOK_LAT = 37.45;  // 삼척
        double DONGHAE_LAT = 37.52;   // 동해
        double YANGYANG_LAT = 37.98;  // 양양
        double SOKCHO_LAT = 38.21;    // 속초

        return restAreas.stream().map(area -> {
            Map<String, Object> classified = new LinkedHashMap<>(area);
            
            String unitName = String.valueOf(area.get("unitNm"));
            String direction = String.valueOf(area.get("direction"));
            
            // 좌표가 있으면 좌표 기반, 없으면 이름 기반
            Object latObj = area.get("coordY");
            
            String fromCity = "";
            String toCity = "";
            int timeMinutes = 0;

            if (latObj != null) {
                // 좌표 기반 분류
                double lat = Double.parseDouble(String.valueOf(latObj));
                
                if (lat < DONGHAE_LAT) {
                    fromCity = "상행".equals(direction) ? "삼척" : "동해";
                    toCity = "상행".equals(direction) ? "동해" : "삼척";
                    timeMinutes = 15;
                } else if (lat < YANGYANG_LAT) {
                    fromCity = "상행".equals(direction) ? "동해" : "양양";
                    toCity = "상행".equals(direction) ? "양양" : "동해";
                    timeMinutes = 30;
                } else {
                    fromCity = "상행".equals(direction) ? "양양" : "속초";
                    toCity = "상행".equals(direction) ? "속초" : "양양";
                    timeMinutes = 20;
                }
            } else {
                // 이름 기반 분류 (백업)
                if (unitName.contains("옥계") || unitName.contains("삼척")) {
                    fromCity = "상행".equals(direction) ? "삼척" : "동해";
                    toCity = "상행".equals(direction) ? "동해" : "삼척";
                    timeMinutes = 15;
                } else if (unitName.contains("현북") || unitName.contains("동해")) {
                    fromCity = "상행".equals(direction) ? "동해" : "양양";
                    toCity = "상행".equals(direction) ? "양양" : "동해";
                    timeMinutes = 30;
                } else if (unitName.contains("양양")) {
                    fromCity = "상행".equals(direction) ? "양양" : "속초";
                    toCity = "상행".equals(direction) ? "속초" : "양양";
                    timeMinutes = 20;
                }
            }

            classified.put("fromCity", fromCity);
            classified.put("toCity", toCity);
            classified.put("timeMinutes", String.valueOf(timeMinutes));
            
            log.info("분류 완료: {} ({}) - {} → {} ({}분)", 
                unitName, direction, fromCity, toCity, timeMinutes);

            return classified;
        }).collect(Collectors.toList());
    }
    
    /* 방향 */
    private String parseDirection(String svarAddr) {
        if (svarAddr == null) return "상행";
        
        svarAddr = svarAddr.toLowerCase();
        
        if (svarAddr.contains("하행") || svarAddr.contains("서울") || svarAddr.contains("춘천")) {
            return "하행";
        } else if (svarAddr.contains("상행") || svarAddr.contains("부산") || svarAddr.contains("속초")) {
            return "상행";
        }
        
        return "상행"; // 기본값
    }

    /* 구간별 휴게소 조회 */
    public List<Map<String, Object>> getRestAreasByRoute(String fromCity, String toCity, String direction) {
        List<Map<String, Object>> allRestAreas = getDonghaeRestAreas();

        List<Map<String, Object>> filtered = allRestAreas.stream()
                .filter(area -> {
                    String areaFrom = String.valueOf(area.get("fromCity"));
                    String areaTo = String.valueOf(area.get("toCity"));
                    String areaDir = String.valueOf(area.get("direction"));

                    boolean matchRoute = fromCity.equals(areaFrom) && toCity.equals(areaTo);
                    boolean matchDir = direction.equals(areaDir);

                    return matchRoute && matchDir;
                })
                .collect(Collectors.toList());

        log.info("구간 조회: {} → {} ({}방향) - {}건", fromCity, toCity, direction, filtered.size());
        return filtered;
    }

    /* API 응답 파싱 */
    @SuppressWarnings("unchecked")
    private List<Map<String, Object>> extractList(Map response) {
        try {
            List<Map<String, Object>> list = (List<Map<String, Object>>) response.get("list");
            return list != null ? list : Collections.emptyList();
        } catch (Exception e) {
            log.warn("응답 파싱 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }
}