package com.trip.travel.service;

import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.UriComponentsBuilder;

import com.fasterxml.jackson.databind.ObjectMapper;

import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
public class ParkingService {

    private final WebClient webClient;

    @Value("${api.parking.key}")
    private String parkingApiKey;

    @Value("${api.parking.base-url}")
    private String baseUrl;

    public ParkingService(WebClient webClient) {
        this.webClient = webClient;
    }

    private static final String CHUNCHEON_CITY_CODE = "42110";
    private static final String GANGNEUNG_CITY_CODE = "42150";
    private static final String SOKCHO_CITY_CODE = "42230";
    private static final String WONJU_CITY_CODE = "42130";
    private static final String DONGHAE_CITY_CODE = "42170";
    private static final String TAEBAEK_CITY_CODE = "42190";
    private static final String SAMCHEOK_CITY_CODE = "42210";
    private static final String PYEONGCHANG_CITY_CODE = "42750";

    // 강원도 전체 주차장 데이터 한 번에 가져오기
    @Cacheable(value = "gangwonParking", key = "'all'")
    private List<Map<String, Object>> getAllGangwonParkingRaw() {
        String url = UriComponentsBuilder.fromUriString(baseUrl + "/PrkSttusInfo")
                .queryParam("serviceKey", parkingApiKey)
                .queryParam("numOfRows", 2000)
                .queryParam("pageNo", 1)
                .queryParam("format", "2")
                .build(false)
                .toUriString();

        try {
            String responseStr = webClient
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(String.class)
                    .block();

            log.info("PrkSttusInfo 응답 성공");
            
            ObjectMapper mapper = new ObjectMapper();
            Map response = mapper.readValue(responseStr, Map.class);
            
            List<Map<String, Object>> items = extractItems(response);
            
            // 강원특별자치도만 필터링
            List<Map<String, Object>> gangwonOnly = items.stream()
                    .filter(item -> {
                        String sido = (String) item.get("prk_plce_adres_sido");
                        return sido != null && sido.equals("강원특별자치도");
                    })
                    .collect(Collectors.toList());
            
            log.info("강원도 주차장 총 {}건", gangwonOnly.size());
            
            return gangwonOnly;
                    
        } catch (Exception e) {
            log.error("강원도 주차장 데이터 조회 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }

    // 도시별로 분류 + 필드명 변환
    public Map<String, List<Map<String, Object>>> getAllGangwonParking() {
        List<Map<String, Object>> allData = getAllGangwonParkingRaw();
        
        Map<String, List<Map<String, Object>>> result = new LinkedHashMap<>();
        
        // 8개 도시별로 분류 + 변환
        result.put("춘천", transformAndFilter(allData, "춘천"));
        result.put("강릉", transformAndFilter(allData, "강릉"));
        result.put("속초", transformAndFilter(allData, "속초"));
        result.put("원주", transformAndFilter(allData, "원주"));
        result.put("동해", transformAndFilter(allData, "동해"));
        result.put("태백", transformAndFilter(allData, "태백"));
        result.put("삼척", transformAndFilter(allData, "삼척"));
        result.put("평창", transformAndFilter(allData, "평창"));
        
        return result;
    }

    @Cacheable(value = "parkingInfo", key = "#cityCode")
    public List<Map<String, Object>> getParkingByCity(String cityCode) {
        String cityName = getCityName(cityCode);
        List<Map<String, Object>> allData = getAllGangwonParkingRaw();
        
        return transformAndFilter(allData, cityName);
    }

    // 필터링 + 변환 헬퍼 메서드
    private List<Map<String, Object>> transformAndFilter(List<Map<String, Object>> allData, String cityName) {
        List<Map<String, Object>> filtered = filterByCity(allData, cityName);
        
        if (filtered.isEmpty()) {
            log.warn("주차장 데이터 없음 - {}, Mock 데이터 반환", cityName);
            return getMockParkingData(getCityCode(cityName));
        }
        
        // 필드명 변환
        return filtered.stream()
                .map(lot -> {
                    Map<String, Object> mapped = new LinkedHashMap<>();
                    mapped.put("parkingName", lot.get("prk_plce_nm"));
                    mapped.put("addr", lot.get("prk_plce_adres"));
                    mapped.put("lat", lot.get("prk_plce_entrc_la"));
                    mapped.put("lng", lot.get("prk_plce_entrc_lo"));
                    mapped.put("totalQty", lot.get("prk_cmprt_co"));
                    mapped.put("remainQty", "0");
                    mapped.put("payYn", "Y");
                    mapped.put("basicCharge", "미확인");
                    mapped.put("operTm", "미확인");
                    return mapped;
                })
                .limit(30)
                .collect(Collectors.toList());
    }

    // 도시별 필터링
    private List<Map<String, Object>> filterByCity(List<Map<String, Object>> allData, String cityName) {
        return allData.stream()
                .filter(item -> {
                    String sigungu = (String) item.get("prk_plce_adres_sigungu");
                    return sigungu != null && sigungu.contains(cityName);
                })
                .collect(Collectors.toList());
    }
    
    @SuppressWarnings("unchecked")
    private List<Map<String, Object>> extractItems(Map response) {
        try {
            Object item = response.get("PrkSttusInfo");
            if (item instanceof List) {
                return (List<Map<String, Object>>) item;
            }
            if (item instanceof Map) {
                return List.of((Map<String, Object>) item);
            }
        } catch (Exception e) {
            log.warn("PrkSttusInfo 파싱 실패: {}", e.getMessage());
        }
        return Collections.emptyList();
    }

    private List<Map<String, Object>> getMockParkingData(String cityCode) {
        List<Map<String, Object>> mock = new ArrayList<>();
        String city = getCityName(cityCode);
        
        String[][] spots = {
            {city + " 공영주차장", "300", "87"},
            {city + " 중앙시장 주차장", "150", "42"},
            {city + " 관광지 주차장", "500", "213"},
        };
        
        for (String[] s : spots) {
            Map<String, Object> m = new LinkedHashMap<>();
            m.put("parkingName", s[0]);
            m.put("totalQty", s[1]);
            m.put("remainQty", s[2]);
            m.put("addr", city + "시");
            m.put("payYn", "Y");
            m.put("basicCharge", "1000");
            m.put("operTm", "24시간");
            mock.add(m);
        }
        return mock;
    }
    
    private String getCityName(String cityCode) {
        return switch (cityCode) {
            case CHUNCHEON_CITY_CODE -> "춘천";
            case GANGNEUNG_CITY_CODE -> "강릉";
            case SOKCHO_CITY_CODE -> "속초";
            case WONJU_CITY_CODE -> "원주";
            case DONGHAE_CITY_CODE -> "동해";
            case TAEBAEK_CITY_CODE -> "태백";
            case SAMCHEOK_CITY_CODE -> "삼척";
            case PYEONGCHANG_CITY_CODE -> "평창";
            default -> "강원";
        };
    }

    // 도시명 -> 코드 변환
    private String getCityCode(String cityName) {
        return switch (cityName) {
            case "춘천" -> CHUNCHEON_CITY_CODE;
            case "강릉" -> GANGNEUNG_CITY_CODE;
            case "속초" -> SOKCHO_CITY_CODE;
            case "원주" -> WONJU_CITY_CODE;
            case "동해" -> DONGHAE_CITY_CODE;
            case "태백" -> TAEBAEK_CITY_CODE;
            case "삼척" -> SAMCHEOK_CITY_CODE;
            case "평창" -> PYEONGCHANG_CITY_CODE;
            default -> CHUNCHEON_CITY_CODE;
        };
    }
}