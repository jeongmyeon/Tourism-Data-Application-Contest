package com.trip.travel.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.UriComponentsBuilder;

import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class RestAreaService {

    private final WebClient.Builder webClientBuilder;

    @Value("${api.restarea.key}")
    private String restAreaApiKey;

    /* 동해고속도로 휴게소 전체 정보 조회 (기본정보 API + 편의시설 API) */
    @Cacheable(value = "restAreas", key = "'donghae'")
    public List<Map<String, Object>> getDonghaeRestAreas() {
        // 1. 기본정보 조회
        List<Map<String, Object>> basicInfo = getBasicRestAreaInfo();
        
        // 2. 편의시설 조회
        List<Map<String, Object>> facilities = getRestAreaFacilities();
        
        // 3. 두 데이터 병합
        return mergeRestAreaData(basicInfo, facilities);
    }

    /* 기본정보 API 호출 */
    private List<Map<String, Object>> getBasicRestAreaInfo() {
        String url = UriComponentsBuilder
                .fromUriString("https://data.ex.co.kr/openapi/basicinfo/openApiInfoM")
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("numOfRows", 500)
                .queryParam("pageNo", 1)
                .build(false)
                .toUriString();

        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            List<Map<String, Object>> allAreas = extractList(response);
            log.info("기본정보 API - 전체: {}건", allAreas.size());

            // 동해고속도로(0650, 650) 필터링
            List<Map<String, Object>> donghaeAreas = allAreas.stream()
                    .filter(area -> {
                        String routeCode = String.valueOf(area.get("routeCd"));
                        String routeName = String.valueOf(area.get("routeNm"));
                        return "0650".equals(routeCode) || 
                               "650".equals(routeCode) ||
                               (routeName != null && routeName.contains("동해"));
                    })
                    .collect(Collectors.toList());

            log.info("동해고속도로 필터링 후: {}건", donghaeAreas.size());
            return donghaeAreas;

        } catch (Exception e) {
            log.error("기본정보 API 조회 실패: {}", e.getMessage());
            e.printStackTrace();
            return Collections.emptyList();
        }
    }

    /* 편의시설 API 호출 */
    private List<Map<String, Object>> getRestAreaFacilities() {
        String url = UriComponentsBuilder
                .fromUriString("https://data.ex.co.kr/openapi/business/curArcdentStatus")
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("numOfRows", 500)
                .queryParam("pageNo", 1)
                .build(false)
                .toUriString();

        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            List<Map<String, Object>> facilities = extractList(response);
            log.info("편의시설 API - 전체: {}건", facilities.size());
            return facilities;

        } catch (Exception e) {
            log.error("편의시설 API 조회 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }

    /* 두 API 데이터 병합 */
    private List<Map<String, Object>> mergeRestAreaData(
            List<Map<String, Object>> basicInfo,
            List<Map<String, Object>> facilities) {
        
        return basicInfo.stream().map(basic -> {
            Map<String, Object> merged = new LinkedHashMap<>(basic);

            String unitCode = String.valueOf(basic.get("unitCd"));
            String unitName = String.valueOf(basic.get("unitNm"));
            String svarAddr = String.valueOf(basic.get("svarAddr")); // 상행/하행

            // 편의시설 정보 매칭
            facilities.stream()
                    .filter(f -> unitCode.equals(String.valueOf(f.get("unitCd"))))
                    .findFirst()
                    .ifPresent(facility -> {
                        List<String> facilityList = new ArrayList<>();
                        if ("Y".equals(facility.get("convenience"))) facilityList.add("편의점");
                        if ("Y".equals(facility.get("restroom"))) facilityList.add("화장실");
                        if ("Y".equals(facility.get("restaurant"))) facilityList.add("식당");
                        if ("Y".equals(facility.get("gas"))) facilityList.add("주유소");
                        if ("Y".equals(facility.get("lpg"))) facilityList.add("LPG충전소");
                        if ("Y".equals(facility.get("parking"))) facilityList.add("주차장");
                        if ("Y".equals(facility.get("elecCharger"))) facilityList.add("전기차충전소");

                        merged.put("facilities", facilityList);
                        merged.put("tel", facility.get("unitTel"));
                        merged.put("operatingHours", facility.get("opTime"));
                    });

            // 기본값 설정
            if (!merged.containsKey("facilities")) {
                merged.put("facilities", Arrays.asList("화장실", "주차장"));
            }

            // 방향 설정
            String direction = "상행"; // 기본값
            if (svarAddr != null) {
                if (svarAddr.contains("하행") || svarAddr.contains("서울")) {
                    direction = "하행";
                } else if (svarAddr.contains("상행") || svarAddr.contains("부산")) {
                    direction = "상행";
                }
            }
            merged.put("direction", direction);
            merged.put("name", unitName);

            // 구간 정보 매핑
            merged.putAll(estimateRouteInfo(unitName, direction));

            return merged;
        }).collect(Collectors.toList());
    }

    /**
     * 휴게소 이름과 방향으로 구간 정보 추정
     */
    private Map<String, String> estimateRouteInfo(String unitName, String direction) {
        Map<String, String> routeInfo = new HashMap<>();

        if (unitName.contains("임원") || unitName.contains("삼척")) {
            if ("상행".equals(direction)) {
                routeInfo.put("fromCity", "삼척");
                routeInfo.put("toCity", "동해");
                routeInfo.put("timeMinutes", "15");
            } else {
                routeInfo.put("fromCity", "동해");
                routeInfo.put("toCity", "삼척");
                routeInfo.put("timeMinutes", "15");
            }
        } else if (unitName.contains("현북") || unitName.contains("동해")) {
            if ("상행".equals(direction)) {
                routeInfo.put("fromCity", "동해");
                routeInfo.put("toCity", "양양");
                routeInfo.put("timeMinutes", "25");
            } else {
                routeInfo.put("fromCity", "양양");
                routeInfo.put("toCity", "동해");
                routeInfo.put("timeMinutes", "25");
            }
        } else if (unitName.contains("양양")) {
            if ("상행".equals(direction)) {
                routeInfo.put("fromCity", "양양");
                routeInfo.put("toCity", "속초");
                routeInfo.put("timeMinutes", "20");
            } else {
                routeInfo.put("fromCity", "속초");
                routeInfo.put("toCity", "양양");
                routeInfo.put("timeMinutes", "20");
            }
        }

        return routeInfo;
    }

    /**
     * 구간별 휴게소 조회
     */
    public List<Map<String, Object>> getRestAreasByRoute(String fromCity, String toCity, String direction) {
        List<Map<String, Object>> allRestAreas = getDonghaeRestAreas();

        return allRestAreas.stream()
                .filter(area -> {
                    String areaFrom = (String) area.get("fromCity");
                    String areaTo = (String) area.get("toCity");
                    String areaDir = (String) area.get("direction");

                    return fromCity.equals(areaFrom) && 
                           toCity.equals(areaTo) && 
                           direction.equals(areaDir);
                })
                .collect(Collectors.toList());
    }

    /**
     * API 응답 파싱
     */
    @SuppressWarnings("unchecked")
    private List<Map<String, Object>> extractList(Map response) {
        try {
            List<Map<String, Object>> list = (List<Map<String, Object>>) response.get("list");
            return list != null ? list : Collections.emptyList();
        } catch (Exception e) {
            log.warn("응답 파싱 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }
}