package com.trip.travel.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.cache.annotation.Cacheable;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;
import org.springframework.web.util.UriComponentsBuilder;

import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class RestAreaService {

    private final WebClient.Builder webClientBuilder;

    @Value("${api.restarea.key}")
    private String restAreaApiKey;
    
    @Value("${api.restarea.base-url}")
    private String baseUrl;


    /* 동해고속도로 휴게소 전체 정보 조회 - 편의시설 포함 */
    public List<Map<String, Object>> getDonghaeRestAreas() {
        // 1. 기본정보 조회
        List<Map<String, Object>> basicInfo = getBasicRestAreaInfo();
        
        // 2. 좌표 조회 
        List<Map<String, Object>> coordinates = getRestAreaCoordinates();
        
        // 3. 편의시설 전체 조회 (restConvList API 사용)
        List<Map<String, Object>> allFacilities = getAllFacilitiesByRoute();
        
        // 4. 데이터 병합 (편의시설 포함)
        return mergeAndClassify(basicInfo, coordinates, allFacilities);
    }

    /* 기본정보 API 호출 */
    private List<Map<String, Object>> getBasicRestAreaInfo() {
        String url = UriComponentsBuilder
                .fromUriString(baseUrl+"/restinfo/hiwaySvarInfoList")
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("routeCd", "0650")
                .queryParam("numOfRows", 50)
                .queryParam("pageNo", 1)
                .build(false)
                .toUriString();

        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            List<Map<String, Object>> list = extractList(response);
            log.info("동해고속도로 휴게소 조회 - 전체: {}건", list.size());

            return list;

        } catch (Exception e) {
            log.error("기본정보 API 조회 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }
    
    /* 좌표 API 호출  */
    private List<Map<String, Object>> getRestAreaCoordinates(){
        String url = UriComponentsBuilder
                .fromUriString(baseUrl + "/locationinfo/locationinfoRest")
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("routeNo","0650")
                .queryParam("numOfRows",100)
                .queryParam("pageNo",1)
                .build(false)
                .toUriString();
        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();
            
            List<Map<String, Object>> list = extractList(response);
            log.info("좌표 조회 : {}건", list.size());
            
            return list;
            
        }catch(Exception e) {
            log.error("좌표 API 실패 : {}", e.getMessage());
            return Collections.emptyList();
        }
    }

    /* 노선 전체 편의시설 조회 - restConvList API 사용 */
    private List<Map<String, Object>> getAllFacilitiesByRoute() {
        String url = UriComponentsBuilder
                .fromUriString(baseUrl + "/restinfo/restConvList")  // ✅ restConvList로 변경
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("routeCd", "0650")  // 동해고속도로
                .queryParam("numOfRows", 200)   // 충분한 수
                .queryParam("pageNo", 1)
                .build(false)
                .toUriString();

        try {
            log.info("🔍 편의시설 API 호출 (restConvList): {}", url);
            
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            log.info("📦 API 응답: {}", response);

            List<Map<String, Object>> list = extractList(response);
            log.info("✅ 전체 편의시설 조회: {}건", list.size());
            
            // 상세 로그: 처음 10개 출력
            if (!list.isEmpty()) {
                log.info("========== 편의시설 샘플 데이터 (restConvList) ==========");
                list.stream().limit(10).forEach(fac -> {
                    log.info("stdRestCd: {}, stdRestNm: {}, psName: {}", 
                        fac.get("stdRestCd"), 
                        fac.get("stdRestNm"),
                        fac.get("psName"));
                });
                log.info("=======================================================");
            }
            
            return list;

        } catch (Exception e) {
            log.error("❌ 전체 편의시설 API 조회 실패: {}", e.getMessage(), e);
            return Collections.emptyList();
        }
    }

    /* 특정 휴게소의 편의시설 조회 (개별 조회용) */
    @Cacheable(value = "restAreaFacilities", key = "#stdRestCd")
    public List<Map<String, Object>> getFacilitiesByStdRestCd(String stdRestCd) {
        String url = UriComponentsBuilder
                .fromUriString(baseUrl + "/restinfo/restConvList")  // ✅ restConvList로 변경
                .queryParam("key", restAreaApiKey)
                .queryParam("type", "json")
                .queryParam("stdRestCd", stdRestCd)  // 특정 휴게소 코드로 조회
                .build(false)
                .toUriString();

        try {
            Map response = webClientBuilder.build()
                    .get()
                    .uri(url)
                    .retrieve()
                    .bodyToMono(Map.class)
                    .block();

            List<Map<String, Object>> list = extractList(response);
            log.info("편의시설 조회 (stdRestCd: {}) : {}건", stdRestCd, list.size());
            
            return list;

        } catch (Exception e) {
            log.error("편의시설 API 조회 실패 (stdRestCd: {}): {}", stdRestCd, e.getMessage());
            return Collections.emptyList();
        }
    }
    
    /* 편의시설 이름만 추출 */
    public List<String> getFacilityNames(String stdRestCd) {
        List<Map<String, Object>> facilities = getFacilitiesByStdRestCd(stdRestCd);
        
        if (facilities.isEmpty()) {
            return Arrays.asList("화장실", "주차장"); // 기본 시설
        }
        
        return facilities.stream()
                .map(fac -> String.valueOf(fac.get("psName")))
                .filter(name -> name != null && !name.equals("null"))
                .distinct()
                .collect(Collectors.toList());
    }
    
    /* 편의시설 상세 정보 조회 */
    public List<Map<String, String>> getFacilityDetails(String stdRestCd) {
        List<Map<String, Object>> facilities = getFacilitiesByStdRestCd(stdRestCd);
        
        return facilities.stream()
                .map(fac -> {
                    Map<String, String> detail = new HashMap<>();
                    detail.put("code", String.valueOf(fac.get("psCode")));
                    detail.put("name", String.valueOf(fac.get("psName")));
                    detail.put("description", String.valueOf(fac.get("psDesc")));
                    detail.put("startTime", String.valueOf(fac.get("stime")));
                    detail.put("endTime", String.valueOf(fac.get("etime")));
                    return detail;
                })
                .collect(Collectors.toList());
    }

    /* API 데이터 병합 - stdRestCd 기반 매칭 */
    private List<Map<String, Object>> mergeAndClassify(
            List<Map<String, Object>> basicInfo,
            List<Map<String, Object>> coordinates,
            List<Map<String, Object>> allFacilities) {
        
        final double GANGWON_LAT_MIN = 37.0;
        final double GANGWON_LAT_MAX = 38.6;
        
        log.info("🔍 병합 시작 - 기본정보: {}건, 좌표: {}건, 편의시설: {}건", 
            basicInfo.size(), coordinates.size(), allFacilities.size());
        
        // stdRestCd별로 편의시설 그룹화
        Map<String, List<String>> facilitiesMap = allFacilities.stream()
                .collect(Collectors.groupingBy(
                        fac -> String.valueOf(fac.get("stdRestCd")),
                        Collectors.mapping(
                                fac -> String.valueOf(fac.get("psName")),
                                Collectors.toList()
                        )
                ));
        
        log.info("========== 편의시설 맵 생성 완료 ==========");
        log.info("총 {}개 휴게소의 편의시설 데이터", facilitiesMap.size());
        facilitiesMap.entrySet().stream().limit(5).forEach(entry -> {
            log.info("stdRestCd: {} → 시설: {}", entry.getKey(), entry.getValue());
        });
        log.info("==========================================");
        
        return basicInfo.stream()
                .map(basic -> {
                    Map<String, Object> merged = new LinkedHashMap<>(basic);

                    String svarNm = String.valueOf(basic.get("svarNm"));
                    String gudClssNm = String.valueOf(basic.get("gudClssNm"));
                    
                    String direction = gudClssNm.contains("상행") || gudClssNm.contains("부산") ? "상행" : "하행";
                    merged.put("direction", direction);
                    merged.put("name", svarNm);
                    
                    // 좌표 매칭
                    coordinates.stream()
                        .filter(coord -> svarNm.contains(String.valueOf(coord.get("unitName"))))
                        .findFirst()
                        .ifPresent(coord -> {
                            merged.put("coordY", coord.get("yValue"));
                            merged.put("coordX", coord.get("xValue"));
                            
                            String stdRestCd = String.valueOf(coord.get("stdRestCd"));
                            merged.put("stdRestCd", stdRestCd);
                            
                            log.info("✅ 좌표 매칭: {} - stdRestCd: {}", svarNm, stdRestCd);
                            
                            // stdRestCd로 편의시설 찾기
                            List<String> facilities = facilitiesMap.get(stdRestCd);
                            
                            if (facilities != null && !facilities.isEmpty()) {
                                merged.put("facilities", facilities);
                                log.info("🎉 편의시설 매칭 성공! {} - 시설: {}", svarNm, facilities);
                            } else {
                                merged.put("facilities", Arrays.asList("화장실", "주차장"));
                                log.warn("⚠️ 편의시설 데이터 없음 (기본값): {} - stdRestCd: {}", svarNm, stdRestCd);
                            }
                        });
                    
                    // 편의시설 기본값 (좌표 매칭 실패 시)
                    if (!merged.containsKey("facilities")) {
                        merged.put("facilities", Arrays.asList("화장실", "주차장"));
                        log.warn("⚠️ 좌표 매칭 실패로 기본값: {}", svarNm);
                    }
                    
                    // 전화번호
                    String rprsTelNo = String.valueOf(basic.get("rprsTelNo"));
                    if(rprsTelNo != null && !rprsTelNo.equals("null") && !rprsTelNo.isEmpty()) {
                        String formattedTel = formatPhoneNumber(rprsTelNo);
                        if(formattedTel != null) {
                            merged.put("tel", formattedTel);
                        }	
                    }
                    
                    return merged;
                })
                .filter(merged -> {
                    Object coordY = merged.get("coordY");
                    if(coordY == null) {
                        log.warn("좌표 X : {}", merged.get("name"));
                        return false;
                    }
                    try {
                        double lat = Double.parseDouble(String.valueOf(coordY));
                        boolean isGangwon = lat >= GANGWON_LAT_MIN && lat <= GANGWON_LAT_MAX;
                        return isGangwon;
                    }catch(Exception e) {
                        log.warn("좌표 파싱 실패: {}", merged.get("name"));
                        return false;
                    }
                })
                .map(merged -> {
                    Object coordY = merged.get("coordY");
                    String direction = String.valueOf(merged.get("direction"));
                    String name = String.valueOf(merged.get("name"));
                    
                    double lat = Double.parseDouble(String.valueOf(coordY));
                    
                    Map<String, String> routeInfo = classigfyByCoordinate(lat, direction, name);
                    merged.putAll(routeInfo);
                    
                    return merged;
                })
                .collect(Collectors.toList());
    }

    /* 휴게소 이름과 방향으로 구간 정보 추정 */
    private Map<String, String> classigfyByCoordinate(double lat, String direction, String name) {
        Map<String, String> info = new HashMap<>();
        
        // 도시 좌표 기준점
        List<Map.Entry<String, Double>> cities = List.of(
                Map.entry("삼척", 37.45),
                Map.entry("동해", 37.65),
                Map.entry("강릉", 37.75),
                Map.entry("양양", 38.07),
                Map.entry("속초", 38.18)
            );
        
        // 현위치
        int segmentIndex = -1;
        for (int i = 0; i < cities.size() - 1; i++) {
            double midpoint = (cities.get(i).getValue() + cities.get(i + 1).getValue()) / 2;
            if (lat < midpoint) {
                segmentIndex = i;
                break;
            }
        }
        
        // 마지막 위치
        if (segmentIndex == -1) {
            segmentIndex = cities.size() - 2;
        }
        
        String segmentStart = cities.get(segmentIndex).getKey();
        String segmentEnd = cities.get(segmentIndex + 1).getKey();
        
        // 방향 설정
        if ("상행".equals(direction)) {
            info.put("fromCity", segmentStart);
            info.put("toCity", segmentEnd);
        } else {
            info.put("fromCity", segmentEnd);
            info.put("toCity", segmentStart);
        }
        
        // 거리계산
        double latDiff = Math.abs(cities.get(segmentIndex + 1).getValue() - cities.get(segmentIndex).getValue());
        int estimatedMinutes = (int) Math.round(latDiff * 110 / 80 * 60); 
        info.put("timeMinutes", String.valueOf(Math.max(5, estimatedMinutes)));
        
        return info;
    }
    
    /* 구간별 휴게소 조회 */
    public List<Map<String, Object>> getRestAreasByRoute(String fromCity, String toCity, String direction) {
        List<Map<String, Object>> result = getDonghaeRestAreas().stream()
                .filter(area -> 
                    fromCity.equals(area.get("fromCity")) &&
                    toCity.equals(area.get("toCity")) &&
                    direction.equals(area.get("direction"))
                )
                .collect(Collectors.toList());
        
        log.info("===== 구간별 조회 결과 =====");
        log.info("구간: {} → {} ({})", fromCity, toCity, direction);
        log.info("휴게소 수: {}", result.size());
        result.forEach(area -> {
            log.info("  - {}: 편의시설 {}", area.get("name"), area.get("facilities"));
        });
        log.info("============================");
        
        return result;
    }
    
    /* 특정 휴게소 상세 정보 조회 (편의시설 포함) */
    public Map<String, Object> getRestAreaDetail(String stdRestCd) {
        Map<String, Object> detail = new HashMap<>();
        
        // 편의시설 상세 정보
        List<Map<String, String>> facilities = getFacilityDetails(stdRestCd);
        detail.put("facilities", facilities);
        
        // 편의시설 이름만
        List<String> facilityNames = getFacilityNames(stdRestCd);
        detail.put("facilityNames", facilityNames);
        
        return detail;
    }

    /* API 응답 파싱 */
    @SuppressWarnings("unchecked")
    private List<Map<String, Object>> extractList(Map response) {
        try {
            List<Map<String, Object>> list = (List<Map<String, Object>>) response.get("list");
            return list != null ? list : Collections.emptyList();
        } catch (Exception e) {
            log.warn("응답 파싱 실패: {}", e.getMessage());
            return Collections.emptyList();
        }
    }
    
    /* 전화번호 포맷팅 */
    private String formatPhoneNumber(String phoneNumber) {
        if (phoneNumber == null || phoneNumber.equals("null") || phoneNumber.isEmpty()) {
            return null;
        }
        
        // 이미 하이픈이 있으면 그대로 반환
        if (phoneNumber.contains("-")) {
            return phoneNumber;
        }
        
        // 하이픈 제거 
        String cleaned = phoneNumber.replaceAll("[^0-9]", "");
        
        // 전화번호 길이에 따라 포맷팅
        if (cleaned.length() == 10) {
            if (cleaned.startsWith("02")) {
                return cleaned.substring(0, 2) + "-" + cleaned.substring(2, 6) + "-" + cleaned.substring(6);
            } else {
                return cleaned.substring(0, 3) + "-" + cleaned.substring(3, 6) + "-" + cleaned.substring(6);
            }
        } else if (cleaned.length() == 11) {
            return cleaned.substring(0, 3) + "-" + cleaned.substring(3, 7) + "-" + cleaned.substring(7);
        } else if (cleaned.length() == 9) {
            return cleaned.substring(0, 2) + "-" + cleaned.substring(2, 5) + "-" + cleaned.substring(5);
        } else {
            // 기본: 그대로 반환
            return phoneNumber;
        }
    }
}