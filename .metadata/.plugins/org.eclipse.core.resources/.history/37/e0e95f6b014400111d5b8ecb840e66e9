package com.trip.travel.controller;

import com.trip.travel.dto.WeatherDto;
import com.trip.travel.service.RestAreaService;
import com.trip.travel.service.TourApiService;
import com.trip.travel.service.WeatherService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

@Slf4j
@RestController
@RequestMapping("/api")
@RequiredArgsConstructor
public class TravelController {

    private final TourApiService tourApiService;
    private final WeatherService weatherService;
    private final RestAreaService restAreaService;

    // 관광지 목록
    @GetMapping("/tour/spots")
    public ResponseEntity<List<Map<String, Object>>> getTourSpots(
            @RequestParam(defaultValue = "12") String contentTypeId,
            @RequestParam(defaultValue = "1") int pageNo) {
        return ResponseEntity.ok(tourApiService.getGangwonTourSpots(contentTypeId, pageNo));
    }

    // 축제 목록
    @GetMapping("/tour/festivals")
    public ResponseEntity<List<Map<String, Object>>> getFestivals() {
        return ResponseEntity.ok(tourApiService.getGangwonFestivals());
    }

    // 검색
    @GetMapping("/tour/search")
    public ResponseEntity<List<Map<String, Object>>> searchSpots(
            @RequestParam("keyword") String keyword) {  
        return ResponseEntity.ok(tourApiService.searchTourSpots(keyword));
    }
    
    // 검색 조회
    @GetMapping("/tour/detail/{contentId}")
    public ResponseEntity<Map<String, Object>> getTourDetail(
    		@PathVariable("contentId") String contentId,
    		@RequestParam(value= "contentTypeId",required= false)String contentTypeId){
    	return ResponseEntity.ok(tourApiService.getTourDetail(contentId, contentTypeId));
    }
    

    // 동해안 4개 도시 통합 정보 (코드 기반)
    @GetMapping("/tour/east-coast")
    public ResponseEntity<Map<String, Object>> getEastCoastInfo() {
        log.info("=== /tour/east-coast 호출됨 ===");
        
        Map<String, Object> result = new LinkedHashMap<>();
        
        // 도시별 시군구코드 매핑
        Map<String, String> cityCodeMap = Map.of(
            "삼척", "4",
            "동해", "3",
            "강릉", "1",
            "양양", "7",
            "속초", "5"
        );
        
        String[] cities = {"삼척", "동해","강릉", "양양", "속초"};
        
        // 전체 데이터 한 번만 조회 (캐시 활용)
        List<Map<String, Object>> allFestivals = tourApiService.getGangwonFestivals();
        List<Map<String, Object>> allTourSpots = tourApiService.getGangwonTourSpots("12", 1);  // 관광지
        List<Map<String, Object>> allRestaurants = tourApiService.getGangwonTourSpots("39", 1); // 맛집
        List<Map<String, Object>> allHotels = tourApiService.getGangwonTourSpots("32", 1);      // 숙박
        
        log.info("전체 데이터 조회 완료 - 관광지:{}건, 축제:{}건, 맛집:{}건, 숙박:{}건", 
            allTourSpots.size(), allFestivals.size(), allRestaurants.size(), allHotels.size());
        
        for (String city : cities) {
            String sigunguCode = cityCodeMap.get(city);
            Map<String, Object> cityData = new LinkedHashMap<>();
            
            // 1. 관광지 (contentTypeId: 12 + sigunguCode)
            List<Map<String, Object>> citySpots = allTourSpots.stream()
                .filter(spot -> {
                    String code = String.valueOf(spot.get("sigungucode"));
                    return sigunguCode.equals(code);
                })
                .limit(6)
                .collect(Collectors.toList());
            cityData.put("spots", citySpots);
            
            // 2. 축제 (contentTypeId: 15 + 주소 필터)
            List<Map<String, Object>> cityFestivals = allFestivals.stream()
                .filter(festival -> {
                    String addr = (String) festival.get("addr1");
                    return addr != null && addr.contains(city);
                })
                .collect(Collectors.toList());
            cityData.put("festivals", cityFestivals);
            
            // 3. 맛집 (contentTypeId: 39 + sigunguCode)
            List<Map<String, Object>> cityRestaurants = allRestaurants.stream()
                .filter(restaurant -> {
                    String code = String.valueOf(restaurant.get("sigungucode"));
                    return sigunguCode.equals(code);
                })
                .limit(6)
                .collect(Collectors.toList());
            cityData.put("restaurants", cityRestaurants);
            
            // 4. 숙박 (contentTypeId: 32 + sigunguCode)
            List<Map<String, Object>> cityHotels = allHotels.stream()
                .filter(hotel -> {
                    String code = String.valueOf(hotel.get("sigungucode"));
                    return sigunguCode.equals(code);
                })
                .limit(6)
                .collect(Collectors.toList());
            cityData.put("hotels", cityHotels);
            
            result.put(city, cityData);
            
            log.info("{} (코드:{}) - 관광지:{}건, 축제:{}건, 맛집:{}건, 숙박:{}건", 
                city, sigunguCode, citySpots.size(), cityFestivals.size(), 
                cityRestaurants.size(), cityHotels.size());
        }
        
        log.info("=== 최종 결과 반환 ===");
        return ResponseEntity.ok(result);
    }

    // 강원도 전체 날씨
    @GetMapping("/weather/gangwon")
    public ResponseEntity<List<WeatherDto>> getGangwonWeather() {
        return ResponseEntity.ok(weatherService.getAllGangwonWeather());
    }

    // 특정 지역 날씨
    @GetMapping("/weather")
    public ResponseEntity<WeatherDto> getWeather(
            @RequestParam("location") String location,
            @RequestParam("nx") int nx,
            @RequestParam("ny") int ny) {
        return ResponseEntity.ok(weatherService.getWeatherByGrid(location, nx, ny));
    }
    
    // 3일치 날씨 조회
    @GetMapping("/weather/forecast")
    public ResponseEntity<List<Map<String, String>>> get3DayForecast(
            @RequestParam("location") String location,
            @RequestParam("nx") int nx,
            @RequestParam("ny") int ny) {
        return ResponseEntity.ok(weatherService.get3DayForecast(location, nx, ny));
    }
    
    // 축제 상세 정보
    @GetMapping("/tour/festival/{contentId}")
    public ResponseEntity<Map<String, Object>> getFestivalDetail(
            @PathVariable("contentId") String contentId) {
        return ResponseEntity.ok(tourApiService.getFestivalDetail(contentId));
    }
    
    // 휴게소 목록
    @GetMapping("/restareas/donghae")
    public ResponseEntity<List<Map<String, Object>>> getDonghaeRestAreas(){
    	return ResponseEntity.ok(restAreaService.getDonghaeRestAreas());
    }
    
    // 휴게소 상세 조회
    @GetMapping("/restarea/route")
    public ResponseEntity<List<Map<String, Object>>> getRestAreasByRoute(
    		@RequestParam String fromCity,
            @RequestParam String toCity,
            @RequestParam String direction){
    	
    	List<Map<String, Object>> result = restAreaService.getRestAreasByRoute(fromCity, toCity, direction);
    	
    	 return ResponseEntity.ok(result);
    }

    // 메인 대시보드 통합
    @GetMapping("/dashboard")
    public ResponseEntity<Map<String, Object>> getDashboard() {
        Map<String, Object> dashboard = Map.of(
            "weather", weatherService.getAllGangwonWeather(),
            "festivals", tourApiService.getGangwonFestivals()
        );
        return ResponseEntity.ok(dashboard);
    }
}